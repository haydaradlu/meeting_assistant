# Database Connection (Standard Docker Compose uses hostname 'db')
DATABASE_URL=postgresql://postgres:admin1212@db:5432/meeting_assistant

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Models Configuration
WHISPER_MODEL=small
WHISPER_LANGUAGE=id
SUMMARY_PERCENTAGE=60

# Upload Directory
UPLOAD_DIR=uploads
